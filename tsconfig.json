{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "declaration": true,
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*", "test/**/*", "action/**/*", "vitest.config.ts"]
}
